vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

# Вопрос: как infrastructure подключается к приложению? Telegram — три шва (вход, выход,
# хранилище + доставка), плюс воркер, который запускает обработку задач (не Telegram).
# Все стрелки — зависимости в коде и идут сверху вниз (внутрь). Состояние (telegram.db)
# и обмен с Bot API сюда не входят.

telegram: {
  telegram-handlers: "telegram-handlers\n(вход)"
  telegram-notifier: "telegram-notifier\n(выход)"
  telegram-channel-cache: "telegram-channel-cache\n(хранилище + доставка)"
}

workers: {
  queue-poller
}

application: {
  enqueue-download
  jobs: "download-job\ndeliver-job"
}

domain.ports: {
  notifier
  resource-cache
}

telegram.telegram-handlers -> application.enqueue-download
workers.queue-poller -> application.jobs
telegram.telegram-notifier -> domain.ports.notifier: implements
telegram.telegram-channel-cache -> domain.ports.resource-cache: implements
application.jobs -> domain.ports.notifier: uses
application.jobs -> domain.ports.resource-cache: uses
