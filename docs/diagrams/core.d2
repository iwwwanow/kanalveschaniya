application -> domain
infrastructure.presentation -> application
infrastructure.repository -> domain
infrastructure.adapters -> domain

domain.ports.track-cache -> domain.ports.track-store: "extends"
infrastructure.adapters.channel-cache -> domain.ports.track-cache: "implements"
infrastructure.adapters.content-cache -> domain.ports.track-store: "implements"

infrastructure: {
  presentation: {
    telegram-bot
  }
  adapters: {
    yt-dlp
    channel-cache
    content-cache
  }
  repository: {
    sqlite: {
      label: "sqlite (data/app.db)"
      queue
      resource
    }
    telegram: {
      label: "telegram (data/telegram.db)"
      telegram_reply_refs
      telegram_track_refs
      telegram_send_queue
    }
  }
  workers: {
    queue-poller
  }
}

application: {
  use-cases: {
    enqueue-download
    process-download
  }
}

domain: {
  interfaces: {
    download-result
    queue-item
    resource
  }
  ports: {
    downloader
    notifier
    track-store
    track-cache: {
      label: "track-cache\n(extends track-store + deliver)"
    }
  }
  repository: {
    queue
    resource
  }
}
