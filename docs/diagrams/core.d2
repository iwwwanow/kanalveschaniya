vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

# Зависимости направлены внутрь: infrastructure -> application -> domain.
# Детали infrastructure — в core.infrastructure.ports.d2 и core.infrastructure.telegram.d2.
infrastructure.presentation -> application.use-cases
infrastructure.workers -> application.use-cases
infrastructure.repository.sqlite -> domain.repository: implements
infrastructure.adapters -> domain.ports: implements

application -> domain

domain.ports.resource-cache -> domain.ports.resource-store: extends
domain.ports.resource-cache -> domain.ports.delivery: extends

# telegram-репозитории: интерфейсы живут в самой infrastructure (не в domain),
# поэтому адаптеры и presentation ходят в них напрямую
infrastructure.adapters -> infrastructure.repository.telegram: uses
infrastructure.presentation -> infrastructure.repository.telegram: uses

infrastructure: {
  presentation: {
    telegram-bot
    health-server
  }
  adapters: {
    yt-dlp
    telegram-notifier
    telegram-channel-cache
    fs-cache-adapter
  }
  repository: {
    sqlite: {
      label: "sqlite (data/app.db)"
      queue
      resource
      error-log
    }
    telegram: {
      label: "telegram (data/telegram.db)"
      reply-refs
      resource-refs
      users
    }
  }
  workers: {
    queue-poller
  }
}

application: {
  use-cases: {
    enqueue-download
    get-user-queue-status
    download-job
    deliver-job
    recover-stuck-jobs
    requeue-blocked-jobs
  }
}

domain: {
  entities: {
    resource
    queue-item
    download-result
    block-reason
  }
  ports: {
    downloader
    notifier
    resource-store
    delivery
    resource-cache: {
      label: "resource-cache\n(resource-store + delivery)"
    }
  }
  repository: {
    queue
    resource
    error-log
  }
}
