vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

# Вопрос диаграммы: какая часть infrastructure подключена к какому порту домена.
# (Порты вызывают два этапа задачи, download-job и deliver-job; связку делает main.ts.)

application.jobs: "download-job\ndeliver-job"

domain: {
  ports: {
    downloader
    notifier
    resource-archive: "resource-archive\n(resource-store + findFile)"
    resource-cache: "resource-cache\n(resource-store + delivery)"
  }
}

infrastructure: {
  yt-dlp
  telegram-notifier
  fs-cache-adapter
  telegram-channel-cache
}

application.jobs -> domain.ports.downloader: uses
application.jobs -> domain.ports.resource-archive: "save / findFile"
application.jobs -> domain.ports.resource-cache: "find / save / deliver"
application.jobs -> domain.ports.notifier: "failures, direct send"

infrastructure.yt-dlp -> domain.ports.downloader: implements
infrastructure.telegram-notifier -> domain.ports.notifier: implements
infrastructure.fs-cache-adapter -> domain.ports.resource-archive: implements
infrastructure.telegram-channel-cache -> domain.ports.resource-cache: implements
