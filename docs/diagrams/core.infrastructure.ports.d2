vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: down

# Вопрос диаграммы: какая часть infrastructure подключена к какому порту домена.
# (Что вызывает порты — два этапа задачи: download-job и deliver-job; связку делает main.ts.)

application: {
  download-job
  deliver-job
}

domain: {
  ports: {
    downloader
    notifier
    resource-store
    resource-cache: "resource-cache\n(resource-store + delivery)"
  }
}

infrastructure: {
  yt-dlp
  telegram-notifier
  fs-cache-adapter
  telegram-channel-cache
}

application.download-job -> domain.ports.downloader: uses
application.download-job -> domain.ports.resource-store: "save (archives)"
application.deliver-job -> domain.ports.resource-cache: "save / deliver (caches)"
application.deliver-job -> domain.ports.notifier: "send file (no cache)"

infrastructure.yt-dlp -> domain.ports.downloader: implements
infrastructure.telegram-notifier -> domain.ports.notifier: implements
infrastructure.fs-cache-adapter -> domain.ports.resource-store: implements
infrastructure.telegram-channel-cache -> domain.ports.resource-cache: implements
