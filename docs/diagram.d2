application -> domain
infrastructure.presentation -> application
infrastructure.repository -> domain
infrastructure.adapters -> domain

infrastructure: {
  presentation: {
    telegram-bot
  }
  adapters: {
    yt-dlp
    channel-cache
  }
  repository: {
    sqlite: {
      label: "sqlite (data/app.db)"
      queue
      resource
    }
    telegram: {
      label: "telegram (data/telegram.db)"
      telegram_reply_refs
      telegram_track_refs
      telegram_send_queue
    }
  }
  workers: {
    queue-poller
  }
}

application: {
  use-cases: {
    enqueue-download
    process-download
  }
}

domain: {
  interfaces: {
    download-result
    queue-item
    resource
  }
  ports: {
    downloader
    notifier
    track-cache
  }
  repository: {
    queue
    resource
  }
}
