{
  "name": "iwwwanow_kanalveschaniya",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:core": "bun --filter core dev",
    "start:core": "bun --filter core start",
    "typecheck": "bun --filter '*' typecheck",
    "test": "bun test",
    "db:generate": "bun run db:generate:core && bun run db:generate:session",
    "db:generate:core": "bun --filter core db:generate",
    "db:generate:session": "bun --filter session db:generate"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
